##
#CONSTRUCTOR

class Student:

    def __init__(self,name,age):

        self.name=name
        self.age=age

student1=Student("Bhargavi",20)

print(student1.name)
print(student1.age)

student2=Student("Anu",19)

print(student2.name)
print(student2.age)

##output given by the vscode:
Bhargavi
20
Anu
19


