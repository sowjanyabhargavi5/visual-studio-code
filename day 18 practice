#EXCEPTION HANDLING IN PYTHON - PART B

#else block

try:
    num = int(input("Enter a number: "))
    print("Number:", num)

except ValueError:
    print("Invalid Input")

else:
    print("Input accepted")

#finally block

try:
    number = 100 / 2
    print(number)

except:
    print("Error")

finally:
    print("Program Finished")

#custom example

try:
    marks = int(input("Enter marks: "))

    if marks < 0:
        raise ValueError

    print("Marks:", marks)

except ValueError:
    print("Marks cannot be negative")


