#UNIQUE NUMBER COLLECTOR

numbers=set()

for i in range(5):

    num=int(input("Enter number: "))

    numbers.add(num)

print("\nUnique Numbers")

for num in numbers:
    print(num)

print("\nTotal Unique Numbers:",len(numbers))




