##creating dictionaries

student = {
    "name": "Bhargavi",
    "age": 20,
    "course": "Python"
}

print(student)

##accesing elements
student = {
    "name": "Bhargavi",
    "age": 20
}

print(student["name"])
print(student["age"])

##adding and updating values
student = {
    "name": "Bhargavi",
    "age": 20
}

student["city"] = "Hyderabad"
student["age"] = 21

print(student)

##removing values
student = {
    "name": "Bhargavi",
    "age": 20,
    "city": "Hyderabad"
}

del student["city"]

print(student)


##keys,values,items
student = {
    "name": "Bhargavi",
    "age": 20
}

print(student.keys())
print(student.values())
print(student.items())

##looping through dictionaries
student = {
    "name": "Bhargavi",
    "age": 20,
    "course": "Python"
}

for key in student:
    print(key, ":", student[key])

##dictionary methods
student = {
    "name": "Bhargavi",
    "age": 20
}

print(student.get("name"))

student.update({"city": "Hyderabad"})

print(student)

student.clear()

print(student)



