#SETS IN PYTHON - PART B

set1={1,2,3,4}

set2={3,4,5,6}

#union

print(set1.union(set2))

#intersection

print(set1.intersection(set2))

#difference

print(set1.difference(set2))

#symmetric difference

print(set1.symmetric_difference(set2))

#looping through set

for item in set1:
    print(item)

#clear method

temp={10,20,30}

print(temp)

temp.clear()

print(temp)

#list to set conversion

numbers=[1,2,2,3,3,4,5]

numbers=set(numbers)

print(numbers)



